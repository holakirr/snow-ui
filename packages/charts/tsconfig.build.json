{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Library build: resolve @holakirr/snow-ui as the peer dependency it is
    // (its published types), not the workspace source used for typechecking.
    "paths": {},
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/test", "src/**/*.test.*", "src/**/*.stories.*"]
}
