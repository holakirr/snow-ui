{
  "name": "snow-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:icons && bun run build:ui",
    "build:icons": "bun run --filter @holakirr/snow-ui-icons build",
    "build:ui": "bun run --filter @holakirr/snow-ui build",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck && tsc -p tsconfig.json",
    "storybook": "storybook dev -p 53741",
    "build:storybook": "storybook build --disable-telemetry",
    "e2e": "bun run --filter @holakirr/snow-ui e2e",
    "clean": "rm -rf packages/*/dist packages/*/storybook-static packages/*/coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-themes": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/vite": "^4.0.1",
    "@types/node": "24",
    "@vitejs/plugin-react": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^9.1.20",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}
