{
	"name": "@holakirr/snow-ui-icons",
	"private": false,
	"version": "2.1.0",
	"main": "./dist/main.cjs",
	"module": "./dist/main.js",
	"types": "./dist/main.d.ts",
	"exports": {
		".": {
			"types": "./dist/main.d.ts",
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"type": "module",
	"author": {
		"name": "Kirill Petunin",
		"email": "kpetunin@icloud.com",
		"url": "https://holakirr.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/holakirr/snow-ui-icons.git#main"
	},
	"homepage": "https://snow-ui-icons.holakirr.com",
	"description": "SnowUI is a React component library designed by ByeWind, implemented and improved by holakirr team for creating beautiful and interactive user interfaces. And this is a part of ui-kit. Icons from original design.",
	"keywords": [
		"react",
		"ui",
		"snowui",
		"snow",
		"icons",
		"snow-ui",
		"snow-ui-icons"
	],
	"packageManager": "bun@1.3.11",
	"scripts": {
		"build": "tsc -b && vite build",
		"test": "vitest run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.3",
		"@chromatic-com/storybook": "^4.1.0",
		"@phosphor-icons/react": "^2.1.10",
		"@storybook/addon-docs": "^9.1.20",
		"@storybook/addon-onboarding": "^9.1.20",
		"@storybook/react-vite": "^9.1.20",
		"@tailwindcss/vite": "^4.0.1",
		"@testing-library/jest-dom": "^6.6.4",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^24.2.0",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.3",
		"@vitejs/plugin-react": "^5.2.0",
		"jsdom": "^26.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"storybook": "^9.1.20",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.9.2",
		"vite": "^7.3.6",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4"
	},
	"license": "MIT"
}
