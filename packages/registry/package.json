{
  "name": "@holakirr/snow-ui-registry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Generates the @snow-ui shadcn registry (copy-paste components) from the @holakirr/snow-ui sources.",
  "scripts": {
