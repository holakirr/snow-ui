{
  "name": "snow-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:icons && bun run build:ui",
    "build:icons": "bun run --filter @holakirr/snow-ui-icons build",
    "build:ui": "bun run --filter @holakirr/snow-ui build",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "storybook": "bun run --filter @holakirr/snow-ui storybook",
    "storybook:icons": "bun run --filter @holakirr/snow-ui-icons storybook",
    "build:storybook": "bun run --filter '*' build:storybook",
    "e2e": "bun run --filter @holakirr/snow-ui e2e",
    "clean": "rm -rf packages/*/dist packages/*/storybook-static packages/*/coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6"
  },
  "engines": {
    "node": ">=18"
  }
}
