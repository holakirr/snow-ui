    "indigo-text": {
      "$value": "{color.indigo}",
      "$description": "Accessibility addition (not in the Figma kit): Secondary/Indigo is 2.07:1 on white, so indigo text is darker in light mode (5.37:1 on background-1); dark mode keeps the Figma indigo (6.11:1 on #333). Link, active Tag."
    },
    "text-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.7,
        "hex": "#ffffff"
      },
      "$description": "Accessibility addition (not in the Figma kit): Black/40% text is 2.85:1 on white, so secondary text (descriptions, captions, table headers, inactive tabs; the text-secondary utility) is Black/60% in light mode (5.74:1 on background-1, at least 5.5:1 on background-2, the Black/4% hover and the Color 1/2 tints) and White/70% in dark mode (7.08:1 on #333, at least 4.76:1 on the lightest popover surface)."
    },
    "red-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.502, 0.502],
        "hex": "#ff8080"
      },
      "$description": "Accessibility addition (not in the Figma kit): Secondary/Red is 3.36:1 on white and 3.76:1 on #333, so error text (FormMessage) is #D42020 in light mode and #FF8080 in dark mode (5.21:1 on background-1 in both)."
    },
    "control-border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.5,
        "hex": "#ffffff"
      },
      "$description": "Accessibility addition (not in the Figma kit): the boundary of form controls — the rings of unchecked Checkbox and Radio, the strokes of the text fields and the Select trigger, the Switch's off track; with more contrast, the stroke of the Slider bar and the Slider range's track. Contrast \"standard\" (the default): the Figma White/20% (1.84:1 on #333). Contrast \"more\" (prefers-contrast: more, data-contrast=\"more\"): White/50%, at least 3.3:1 on every surface and field fill (WCAG 1.4.11)."
    },
    "control-border-strong": {
      "$value": "{color.black-80}",
      "$description": "Accessibility addition (not in the Figma kit): the hover and focus boundary of form controls (text field strokes, Checkbox and Radio rings, the Switch's off track) and the hovered Search icon; with more contrast, the border of the Slider range's thumbs. Contrast \"standard\" (the default): the Figma White/40% (3.41:1 on #333). Contrast \"more\": White/80% (8.7:1), stronger than control-border."
    },
    "placeholder": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.75,
        "hex": "#ffffff"
      },
      "$description": "Accessibility addition (not in the Figma kit): the placeholder text of the native text fields (Input, InputSmall, Textarea, Search) and the Search icon. Contrast \"standard\" (the default): the Figma White/20% (1.84:1 on #333). Contrast \"more\": White/75%, at least 4.63:1 on every field fill (WCAG 1.4.3)."
    },
    "control-border-invalid": {
      "$value": "{color.red-text}",
      "$description": "Accessibility addition (a token for the kit's Error stroke, Secondary/Red on its text fields, with a stronger value for more contrast): the stroke of an invalid form control (`aria-invalid`: text fields, the Select trigger, Checkbox and Radio rings, Switch, Slider). Contrast \"standard\" (the default): Secondary/Red (3.76:1 on #333, but 2.32:1 on a gray field in a popover). Contrast \"more\": red-text, at least 3.22:1 on every surface and field fill (WCAG 1.4.11)."
    }
