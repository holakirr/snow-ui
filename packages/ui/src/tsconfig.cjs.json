{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".tmp/tsconfig.cjs.tsbuildinfo",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "../dist/cjs",
    "target": "ES2020",
    "allowSyntheticDefaultImports": true,
    "paths": {}
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["test", "**/*.test.*", "**/*.stories.*", "tsconfig.*"]
}
