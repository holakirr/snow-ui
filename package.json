{
  "name": "snow-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run build:icons && bun run build:ui && bun run build:charts",
    "build:all": "bun run build && bun run build:demo",
    "build:icons": "bun run --filter @holakirr/snow-ui-icons build",
    "build:ui": "bun run --filter @holakirr/snow-ui build",
    "build:charts": "bun run --filter @holakirr/snow-ui-charts build",
    "build:demo": "bun run --filter @holakirr/snow-ui-demo build",
    "tokens": "bun run --filter @holakirr/snow-ui tokens",
    "test": "bun run --filter './packages/*' test && bun run test:scripts",
    "test:scripts": "vitest run -c scripts/vitest.config.ts",
    "test:dist": "bun run --filter @holakirr/snow-ui --filter @holakirr/snow-ui-charts test:dist",
    "test:storybook": "vitest run --project storybook --project storybook-dark",
    "test:storybook:browsers": "vitest run -c vitest.browsers.config.ts",
    "test:ssr": "vitest run -c ssr/vitest.config.ts --project ssr-render && vitest run -c ssr/vitest.config.ts --project ssr-hydrate",
    "test:demo": "bun run --filter @holakirr/snow-ui-demo test:e2e",
    "test:coverage": "vitest run --coverage --project @holakirr/snow-ui --project @holakirr/snow-ui-charts --project storybook --project storybook-dark",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter './packages/*' typecheck && tsc -p tsconfig.json",
    "typecheck:demo": "bun run --filter @holakirr/snow-ui-demo typecheck",
    "demo": "bun run --filter @holakirr/snow-ui-demo dev",
    "storybook": "storybook dev -p 53741",
    "build:storybook": "storybook build --disable-telemetry",
    "size": "size-limit",
    "visual": "bash visual/docker.sh",
    "visual:update": "bash visual/docker.sh --update",
    "visual:test": "playwright test -c visual/playwright.config.ts",
    "code-connect": "figma connect parse --skip-update-check --exit-on-unreadable-files --outFile /dev/null",
    "clean": "rm -rf packages/*/dist packages/*/storybook-static packages/*/coverage coverage apps/*/.next apps/*/test-results apps/*/playwright-report",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun run build && bun scripts/publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@figma/code-connect": "^2.0.1",
    "@playwright/test": "1.63.0",
    "@size-limit/esbuild": "^14.1.0",
    "@size-limit/file": "^14.1.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.2",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "size-limit": "^14.1.0",
    "storybook": "^10.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
