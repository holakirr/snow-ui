{
  "name": "@holakirr/snow-ui",
  "private": false,
  "version": "5.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "module": "./dist/index.js",
  "style": "dist/index.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": {
    "name": "Kirill Petunin",
    "email": "kpetunin@icloud.com",
    "url": "https://holakirr.com"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react-hook-form": {
      "import": "./dist/react-hook-form.js",
      "require": "./dist/react-hook-form.cjs"
    },
    "./package.json": "./package.json",
    "./index.css": "./dist/index.css",
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts-italic.css": "./dist/fonts-italic.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holakirr/snow-ui.git",
    "directory": "packages/ui"
  },
  "description": "SnowUI is a React component library designed by ByeWind, implemented and improved by holakirr for creating beautiful and interactive user interfaces.",
  "homepage": "https://snow-ui.holakirr.com",
  "keywords": [
    "react",
    "ui",
    "snow-ui",
    "snow"
  ],
  "license": "MIT AND OFL-1.1",
  "scripts": {
    "build": "rm -rf dist && bun run tokens && bun run build:css && tsdown",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/index.css --minify && bun scripts/build-css.ts",
    "tokens": "tz build && biome format --write src/styles/tokens.generated.css src/foundations/tokens.generated.ts src/utils/token-scales.generated.ts",
    "typecheck": "tsc -p . --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "test": "vitest run",
    "test:dist": "vitest run -c vitest.dist.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "commit": "better-commits",
    "clean:build": "rm -rf dist/ build-storybook.log storybook-static/ migration-storybook.log coverage/",
    "clean:node_modules": "rm -rf node_modules/",
    "clean:all": "bun run clean:build && bun run clean:node_modules"
  },
  "bugs": {
    "url": "https://github.com/holakirr/snow-ui/issues"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
  "dependencies": {
    "@holakirr/snow-ui-icons": "^2.2.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-compose-refs": "^1.1.5",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-direction": "1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/parser": "^2.7.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "better-commits": "^1.26.1",
    "jsdom": "^30.1.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=18"
  },
  "inlinedDependencies": {
    "@phosphor-icons/react": "2.1.10"
  }
}
