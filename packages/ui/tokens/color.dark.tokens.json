{
  "color": {
    "$type": "color",
    "$description": "Figma \"Colors\" collection, SnowUI-Dark mode, plus the library's additions (no \"figma\" name in $extensions).",
    "primary": {
      "$value": "{color.indigo}",
      "$description": "Figma alias: Black/100% in SnowUI-Light, Secondary/Indigo in SnowUI-Dark.",
      "$extensions": {
        "com.holakirr.snow-ui": { "figma": "Primary" }
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5412, 0.5412, 0.7882],
        "hex": "#8a8ac9"
      },
      "$description": "Primary under a White/20% overlay: Figma's Filled Button hover.",
      "$extensions": {
        "com.holakirr.snow-ui": {
          "figma": "Primary + White/20%",
          "css": "color-mix(in srgb, {color.primary}, {color.white} 20%)"
        }
      }
    },
    "primary-hover-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4078, 0.4078, 0.5922],
        "hex": "#686897"
      },
      "$description": "Primary under a White/40% overlay: checked Checkbox / Radio / Switch hover.",
      "$extensions": {
        "com.holakirr.snow-ui": {
          "figma": "Primary + White/40%",
          "css": "color-mix(in srgb, {color.primary}, {color.white} 40%)"
        }
      }
    },
    "black": {
