{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    // `figma`: the runtime module of the Code Connect templates
    // (`*.figma.ts`), so they typecheck against the components' props.
    "types": ["node", "@figma/code-connect/figma-types-no-require"],
    // Typecheck against the icons workspace source so a fresh clone doesn't
    // need `packages/icons/dist`. The emitting configs in src/ reset this.
    "paths": {
      "@holakirr/snow-ui-icons": ["../icons/src/main.tsx"]
    }
  },
  "include": ["src", "scripts", "test", "*.config.ts", "workspace-aliases.ts"],
  // test/types checks the built declarations (`bun run test:dist`).
  "exclude": ["node_modules", "dist", "test/types"]
}
