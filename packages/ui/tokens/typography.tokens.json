{
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": ["Inter", "sans-serif"],
      "$description": "Inter with the \"ss01\" (open digits) and \"cv01\" (alternate one) features, as in the Figma kit. The Google Fonts build of Inter lacks them.",
      "$extensions": {
        "com.holakirr.snow-ui": {
          "fontFeatureSettings": "\"ss01\" 1, \"cv01\" 1"
        }
      }
    }
  },
  "text": {
    "$type": "typography",
    "$description": "Figma text styles, \"<size> Regular\" and \"<size> Semibold\". The two weights of a size share its font size and line height, which become `--text-<size>` and `--text-<size>--line-height` (in rem); the weight comes from `font-normal` / `font-semibold`.",
    "12": {
      "regular": {
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": { "value": 12, "unit": "px" },
          "fontWeight": 400,
          "letterSpacing": { "value": 0, "unit": "px" },
          "lineHeight": { "value": 16, "unit": "px" }
        }
      },
      "semibold": {
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": { "value": 12, "unit": "px" },
          "fontWeight": 600,
          "letterSpacing": { "value": 0, "unit": "px" },
          "lineHeight": { "value": 16, "unit": "px" }
        }
      }
    },
