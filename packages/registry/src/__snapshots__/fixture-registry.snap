{
  "registry": {
    "$schema": "https://ui.shadcn.com/schema/registry.json",
    "name": "test-ui",
    "homepage": "https://ui.example.test",
    "items": [
      {
        "name": "button",
        "type": "registry:ui",
        "title": "Button",
        "description": "Button starts an action. It has one variant.",
        "author": "Test",
        "dependencies": [
          "@radix-ui/react-slot@^1.3.0"
        ],
        "registryDependencies": [
          "http://localhost:4173/r/core.json",
          "http://localhost:4173/r/text.json"
        ],
        "files": [
          {
            "path": "test-ui/components/Button/Button.tsx",
            "type": "registry:ui",
            "target": "@components/test-ui/components/Button/Button.tsx"
          }
        ],
        "meta": {
          "package": "@test/ui",
          "version": "1.2.3",
          "license": "MIT",
          "source": "https://example.test/blob/main/pkg/src/components/Button",
          "import": "components/Button/Button",
          "docs": "https://ui.example.test/?path=/docs/components-button--docs"
        }
      },
      {
        "name": "menu",
        "type": "registry:ui",
        "title": "Menu",
        "description": "Menu component from @test/ui.",
        "author": "Test",
        "registryDependencies": [
          "http://localhost:4173/r/kbd.json",
          "http://localhost:4173/r/text.json",
          "http://localhost:4173/r/use-thing.json"
        ],
        "files": [
          {
            "path": "test-ui/components/Menu/Menu.tsx",
            "type": "registry:ui",
            "target": "@components/test-ui/components/Menu/Menu.tsx"
          },
          {
            "path": "test-ui/components/Menu/surface.ts",
            "type": "registry:ui",
            "target": "@components/test-ui/components/Menu/surface.ts"
          },
          {
            "path": "test-ui/LICENSE",
            "type": "registry:file",
            "target": "@components/test-ui/LICENSE"
          }
        ],
        "meta": {
          "package": "@test/ui",
          "version": "1.2.3",
          "license": "MIT",
          "source": "https://example.test/blob/main/pkg/src/components/Menu",
          "import": "components/Menu/Menu"
        }
      },
      {
        "name": "kbd",
        "type": "registry:ui",
        "title": "Kbd",
        "description": "A keyboard key.",
        "author": "Test",
        "registryDependencies": [
          "http://localhost:4173/r/text.json"
        ],
        "files": [
          {
            "path": "test-ui/components/Text/Kbd.tsx",
            "type": "registry:ui",
            "target": "@components/test-ui/components/Text/Kbd.tsx"
          },
          {
            "path": "test-ui/LICENSE",
            "type": "registry:file",
            "target": "@components/test-ui/LICENSE"
          }
        ],
        "meta": {
          "package": "@test/ui",
          "version": "1.2.3",
          "license": "MIT",
          "source": "https://example.test/blob/main/pkg/src/components/Text",
          "import": "components/Text/Kbd"
        }
      },
      {
        "name": "text",
        "type": "registry:ui",
        "title": "Text",
        "description": "Text component from @test/ui.",
        "author": "Test",
        "files": [
          {
            "path": "test-ui/components/Text/Text.tsx",
            "type": "registry:ui",
            "target": "@components/test-ui/components/Text/Text.tsx"
          },
          {
            "path": "test-ui/LICENSE",
            "type": "registry:file",
            "target": "@components/test-ui/LICENSE"
          }
        ],
        "meta": {
          "package": "@test/ui",
          "version": "1.2.3",
          "license": "MIT",
          "source": "https://example.test/blob/main/pkg/src/components/Text",
          "import": "components/Text/Text"
        }
      },
      {
        "name": "use-other",
        "type": "registry:hook",
        "title": "useOther",
        "description": "useOther hook from @test/ui.",
        "author": "Test",
        "files": [
          {
            "path": "test-ui/hooks/use-other.ts",
            "type": "registry:hook",
            "target": "@components/test-ui/hooks/use-other.ts"
          },
          {
            "path": "test-ui/LICENSE",
            "type": "registry:file",
            "target": "@components/test-ui/LICENSE"
          }
        ],
        "meta": {
          "package": "@test/ui",
          "version": "1.2.3",
          "license": "MIT",
          "source": "https://example.test/blob/main/pkg/src/hooks",
          "import": "hooks/use-other"
        }
      },
      {
        "name": "use-thing",
        "type": "registry:hook",
        "title": "useThing",
        "description": "useThing hook from @test/ui.",
        "author": "Test",
        "files": [
          {
            "path": "test-ui/hooks/use-thing.ts",
            "type": "registry:hook",
            "target": "@components/test-ui/hooks/use-thing.ts"
          },
          {
            "path": "test-ui/LICENSE",
            "type": "registry:file",
            "target": "@components/test-ui/LICENSE"
          }
        ],
        "meta": {
          "package": "@test/ui",
          "version": "1.2.3",
          "license": "MIT",
          "source": "https://example.test/blob/main/pkg/src/hooks",
          "import": "hooks/use-thing"
        }
      },
      {
        "name": "core",
        "type": "registry:lib",
        "title": "Core",
        "description": "Shared utilities.",
        "author": "Test",
        "dependencies": [
          "clsx@^2.1.0"
        ],
        "files": [
          {
            "path": "test-ui/utils/cn.ts",
            "type": "registry:lib",
            "target": "@components/test-ui/utils/cn.ts"
          },
          {
            "path": "test-ui/utils/env.ts",
            "type": "registry:lib",
            "target": "@components/test-ui/utils/env.ts"
          },
          {
            "path": "test-ui/LICENSE",
            "type": "registry:file",
            "target": "@components/test-ui/LICENSE"
          }
        ],
        "meta": {
          "package": "@test/ui",
          "version": "1.2.3",
          "license": "MIT",
          "source": "https://example.test/blob/main/pkg/src/utils"
        }
      },
      {
        "extends": "none",
        "config": {
          "registries": {
            "@test-ui": "http://localhost:4173/r/{name}.json"
          }
        },
        "css": {
          "@import \"@test/ui/theme.css\"": {}
        },
        "name": "base",
        "type": "registry:base",
        "title": "Base",
        "description": "The theme.",
        "author": "Test",
        "dependencies": [
          "@test/ui@file:/abs/test-ui.tgz"
        ],
        "registryDependencies": [
          "http://localhost:4173/r/core.json"
        ],
        "meta": {
          "package": "@test/ui",
          "version": "1.2.3",
          "license": "MIT"
        }
      },
      {
        "name": "all",
        "type": "registry:item",
        "title": "All",
        "description": "Everything.",
        "author": "Test",
        "registryDependencies": [
          "http://localhost:4173/r/button.json",
          "http://localhost:4173/r/menu.json",
          "http://localhost:4173/r/kbd.json",
          "http://localhost:4173/r/text.json",
          "http://localhost:4173/r/use-other.json",
          "http://localhost:4173/r/use-thing.json",
          "http://localhost:4173/r/core.json"
        ],
        "meta": {
          "package": "@test/ui",
          "version": "1.2.3",
          "license": "MIT"
        }
      }
    ]
  },
  "files": {
    "test-ui/components/Button/Button.tsx": "import { Slot } from '@radix-ui/react-slot'\nimport type { ReactNode } from 'react'\nimport { cn } from '../../utils/cn'\nimport { Text } from '../Text/Text'\n\n/*\n * Test UI\n * https://example.test/blob/main/pkg/src/components/Button/Button.tsx\n * MIT License\n */\n\n/** Button runs an action. */\nexport const Button = ({ asChild, children }: { asChild?: boolean; children?: ReactNode }) => {\n  const Component = asChild ? Slot : 'button'\n  return <Component className={cn('px-2')}><Text>{children}</Text></Component>\n}\n",
    "test-ui/components/Menu/Menu.tsx": "'use client'\n\nimport { useThing } from '../../hooks/use-thing'\nimport { Kbd } from '../Text/Kbd'\nimport type { TextProps } from '../Text/Text'\nimport { surface } from './surface'\n\n/*\n * Test UI\n * https://example.test/blob/main/pkg/src/components/Menu/Menu.tsx\n * MIT License\n */\n\nexport const Menu = (props: TextProps) => {\n  useThing()\n  return <div className={surface}><Kbd keys=\"K\" />{props.children}</div>\n}\n",
    "test-ui/components/Menu/surface.ts": "export const surface = 'rounded-12'\n\n/*\n * Test UI\n * https://example.test/blob/main/pkg/src/components/Menu/surface.ts\n * MIT License\n */\n",
    "test-ui/LICENSE": "MIT License\n\nCopyright (c) 2024 Test\n",
    "test-ui/components/Text/Kbd.tsx": "import { Text } from './Text'\n\n/*\n * Test UI\n * https://example.test/blob/main/pkg/src/components/Text/Kbd.tsx\n * MIT License\n */\n\n/** A keyboard key. */\nexport const Kbd = ({ keys }: { keys: string }) => <kbd><Text>{keys}</Text></kbd>\n",
    "test-ui/components/Text/Text.tsx": "import type { ReactNode } from 'react'\n\n/*\n * Test UI\n * https://example.test/blob/main/pkg/src/components/Text/Text.tsx\n * MIT License\n */\n\nexport type TextProps = { children?: ReactNode }\n\nexport const Text = ({ children }: TextProps) => <span>{children}</span>\n",
    "test-ui/hooks/use-other.ts": "export const useOther = () => 1\n\n/*\n * Test UI\n * https://example.test/blob/main/pkg/src/hooks/use-other.ts\n * MIT License\n */\n",
    "test-ui/hooks/use-thing.ts": "'use client'\n\nimport { useState } from 'react'\n\n/*\n * Test UI\n * https://example.test/blob/main/pkg/src/hooks/use-thing.ts\n * MIT License\n */\n\nexport function useThing() {\n  return useState(0)\n}\n",
    "test-ui/utils/cn.ts": "import { clsx } from 'clsx'\n\n/*\n * Test UI\n * https://example.test/blob/main/pkg/src/utils/cn.ts\n * MIT License\n */\n\nexport const cn = (...classes: string[]) => clsx(classes)\n",
    "test-ui/utils/env.ts": "/** Development build. */\nexport const dev = true\n\n/*\n * Test UI\n * https://example.test/blob/main/pkg/src/utils/env.ts\n * MIT License\n */\n"
  }
}
