{
  "name": "@holakirr/snow-ui-icons",
  "private": false,
  "version": "2.1.0",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "types": "./dist/main.d.cts",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "author": {
    "name": "Kirill Petunin",
    "email": "kpetunin@icloud.com",
    "url": "https://holakirr.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holakirr/snow-ui.git",
    "directory": "packages/icons"
  },
  "homepage": "https://snow-ui.holakirr.com/?path=/docs/icons--docs",
  "description": "SnowUI is a React component library designed by ByeWind, implemented and improved by holakirr team for creating beautiful and interactive user interfaces. And this is a part of ui-kit. Icons from original design.",
  "keywords": [
    "react",
    "ui",
    "snowui",
    "snow",
    "icons",
    "snow-ui",
    "snow-ui-icons"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
