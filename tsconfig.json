{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  // Root-level tooling only; each package has its own tsconfig.
  "include": [
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "vitest.config.ts",
    "vitest.browsers.config.ts",
    "ssr/*.ts",
    "ssr/*.tsx",
    "visual/*.ts",
    "scripts/*.ts"
  ]
}
